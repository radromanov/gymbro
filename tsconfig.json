{
    "$schema": "https://www.schemastore.org/tsconfig",
    "display": "Node LTS (24)",
    "_version": "24.0.0",
    "compilerOptions": {
        "lib": [
            "es2024",
            "ESNext.Array",
            "ESNext.Collection",
            "ESNext.Iterator",
            "ESNext.Promise",
            "DOM",
        ],
        "types": ["node"],
        "module": "nodenext",
        "target": "es2024",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "moduleResolution": "node16",
        "outDir": "dist",
        "rootDir": "src",
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist", "tests"],
}
